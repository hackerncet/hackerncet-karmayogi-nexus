{
  "name": "karmayogi-nexus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-workers.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/build-workers.mjs && vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser:bundled": "node scripts/test-browser.mjs",
    "alignment": "node scripts/check-alignment.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.1",
